{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://matika/v2/bedrock-vision/output_schema.json",
  "title": "Matika v2 vision LLM structured output",
  "description": "JSON contract emitted by Claude Haiku/Sonnet vision inside <output> tags. See backend/lambdas/bedrock-vision/prompts/extract_value.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["value", "unit", "confidence", "rationale"],
  "properties": {
    "value": { "type": "number" },
    "unit": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "rationale": { "type": "string", "minLength": 1 }
  }
}
