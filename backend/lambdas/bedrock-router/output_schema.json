{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://matika/v2/bedrock-router/output_schema.json",
  "title": "Matika v2 LLM structured output",
  "description": "JSON contract emitted by Claude Haiku/Sonnet inside <output> tags. See backend/lambdas/bedrock-router/prompts/system_v2.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["responseText", "ttsHints", "extractedValues", "actions", "stateTransition", "escalationReason"],
  "properties": {
    "responseText": {
      "type": "string",
      "minLength": 1,
      "description": "Spoken response text in the patient's language."
    },
    "ttsHints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "spellOutNumbers"],
      "properties": {
        "language": {
          "type": "string",
          "enum": ["en-IN", "hi-IN", "bn-IN"]
        },
        "spellOutNumbers": { "type": "boolean" },
        "rate": { "type": "number", "minimum": 0.5, "maximum": 1.5 }
      }
    },
    "extractedValues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameter", "value", "unit", "loincCode", "status", "confidence"],
        "properties": {
          "parameter": {
            "type": "string",
            "enum": [
              "blood_pressure_systolic",
              "blood_pressure_diastolic",
              "blood_glucose",
              "blood_glucose_fasting",
              "blood_glucose_postprandial",
              "body_temperature_c",
              "body_temperature_f",
              "spo2",
              "heart_rate",
              "body_weight"
            ]
          },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "loincCode": { "type": "string", "pattern": "^[0-9]+-[0-9]+$" },
          "status": {
            "type": "string",
            "enum": ["pending_confirmation", "confirmed", "rejected"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "request_photo",
              "escalate_emergency",
              "pause_session",
              "complete_session",
              "confirm_value"
            ]
          },
          "reason": { "type": "string" }
        }
      }
    },
    "stateTransition": {
      "type": "string",
      "pattern": "^(CREATED|GREETING|EXTRACTING|PENDING_CONFIRMATION|AWAITING_PHOTO|PLAUSIBILITY_CHALLENGE|EMERGENCY|PAUSED|COMPLETE|TERMINAL|EXTRACTING_PROFILE|AWAITING_PROFILE_CONFIRMATION|PROFILE_CONFIRMED)\\s*->\\s*(CREATED|GREETING|EXTRACTING|PENDING_CONFIRMATION|AWAITING_PHOTO|PLAUSIBILITY_CHALLENGE|EMERGENCY|PAUSED|COMPLETE|TERMINAL|EXTRACTING_PROFILE|AWAITING_PROFILE_CONFIRMATION|PROFILE_CONFIRMED)$"
    },
    "escalationReason": {
      "type": ["string", "null"],
      "enum": [
        "implausible_value",
        "emergency",
        "caregiver_protocol_design",
        "cross_session_continuity",
        "low_confidence_extraction",
        "code_switch_density_high",
        "long_response_expected",
        null
      ]
    },
    "patientProfile": {
      "description": "F23 — present only on caregiver_onboarding profile-extraction turns. Set when the LLM has captured fields that should be persisted at the mid-session pivot. See spec §6.9. Empty string permitted on early turns before the name is captured; create-patient-from-voice rejects empty name at pivot time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "nameConfidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "ageYears": { "type": ["number", "null"] },
        "ageConfidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "dateOfBirth": { "type": ["string", "null"], "description": "ISO YYYY-MM-DD" },
        "gender": { "type": ["string", "null"], "enum": ["male", "female", "other", null] },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "medications": { "type": "array", "items": { "type": "string" } },
        "allergies": { "type": "array", "items": { "type": "string" } },
        "emergencyContactName": { "type": ["string", "null"] },
        "primaryDoctor": { "type": ["string", "null"] },
        "primaryLanguage": { "type": ["string", "null"], "enum": ["en-IN", "hi-IN", "bn-IN", null] }
      }
    }
  }
}
